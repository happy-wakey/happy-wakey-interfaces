{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.happy-wakey.dev/async-operation.schema.json",
  "title": "Happy Wakey durable asynchronous operation contracts",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation_id", "operation"],
      "properties": {
        "schema": { "const": "happy-wakey.async-operation.request.v1" },
        "operation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "operation": { "const": "list_alarms" }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation_id", "response_subject"],
      "properties": {
        "schema": { "const": "happy-wakey.async-operation.accepted.v1" },
        "operation_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "response_subject": {
          "type": "string",
          "pattern": "^happy-wakey\\.responses\\.[0-9a-f-]{36}$",
          "maxLength": 128
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation_id"],
      "properties": {
        "schema": { "const": "happy-wakey.async-operation.signal.v1" },
        "operation_id": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/accepted" },
    { "$ref": "#/$defs/signal" }
  ]
}
