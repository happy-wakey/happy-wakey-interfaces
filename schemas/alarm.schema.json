{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.happy-wakey.dev/alarm.schema.json",
  "title": "Happy Wakey alarm",
  "$defs": {
    "alarm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "local_time", "time_zone", "weekdays", "enabled", "sound", "volume", "gradual_seconds", "tags", "generation", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "local_time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$" },
        "time_zone": { "type": "string", "pattern": "^[A-Za-z_+-]+(?:/[A-Za-z0-9_+-]+)+$", "maxLength": 64 },
        "weekdays": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "uniqueItems": true, "minItems": 1, "maxItems": 7 },
        "enabled": { "type": "boolean" },
        "sound": { "type": "string", "minLength": 1, "maxLength": 128 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "gradual_seconds": { "type": "integer", "minimum": 0, "maximum": 1800 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 }, "uniqueItems": true, "maxItems": 20 },
        "generation": { "$ref": "common.schema.json#/$defs/generation" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "create_alarm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "label", "local_time", "time_zone", "weekdays", "enabled", "sound", "volume", "gradual_seconds", "tags"],
      "properties": {
        "transition_id": { "$ref": "common.schema.json#/$defs/transition_id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "local_time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$" },
        "time_zone": { "type": "string", "minLength": 3, "maxLength": 64 },
        "weekdays": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "uniqueItems": true, "minItems": 1, "maxItems": 7 },
        "enabled": { "type": "boolean" },
        "sound": { "type": "string", "minLength": 1, "maxLength": 128 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "gradual_seconds": { "type": "integer", "minimum": 0, "maximum": 1800 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 }, "uniqueItems": true, "maxItems": 20 }
      }
    }
  },
  "$ref": "#/$defs/alarm"
}

