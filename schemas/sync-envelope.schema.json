{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.happy-wakey.dev/sync-envelope.schema.json",
  "title": "Happy Wakey sync envelope",
  "description": "The two-way change log between a device and Happy Wakey Sync. Sleep and biometric summaries are deliberately absent from `collection`: physiological records are read per device from the platform health store under their own consent and are not replicated through this general-purpose log. Adding them would need its own review, not a new enum value.",
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "scope", "collection", "entity_id", "operation", "generation", "actor_id", "document", "occurred_at"],
      "properties": {
        "change_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 128 },
        "collection": {
          "enum": [
            "alarms",
            "alarm_occurrences",
            "routines",
            "tasks",
            "preferences",
            "habits",
            "habit_entries",
            "day_plans",
            "plan_blocks",
            "focus_sessions",
            "provider_connections",
            "module_layouts",
            "watchlist_symbols",
            "price_alerts",
            "vip_senders"
          ]
        },
        "entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "operation": { "enum": ["upsert", "delete"] },
        "generation": { "$ref": "common.schema.json#/$defs/generation" },
        "actor_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "document": {},
        "occurred_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "delete" } } }, "then": { "properties": { "document": { "type": "null" } } } },
        { "if": { "properties": { "operation": { "const": "upsert" } } }, "then": { "properties": { "document": { "type": "object" } } } }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cursor", "changes", "has_more"],
  "properties": {
    "schema": { "const": "happy-wakey/sync/v1" },
    "cursor": { "$ref": "common.schema.json#/$defs/cursor" },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" }, "maxItems": 500 },
    "has_more": { "type": "boolean" }
  }
}
