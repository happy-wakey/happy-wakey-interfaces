{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.happy-wakey.dev/module-layout.schema.json",
  "title": "Happy Wakey module layout",
  "description": "How the owner has arranged their dashboard, and the freshness budget each module is allowed. `refresh_interval_seconds` is a floor the client must respect rather than a target it may beat, because every module maps onto an upstream quota. Contexts let the same surface re-order itself by time of day without a second saved layout.",
  "$defs": {
    "module": {
      "enum": [
        "briefing",
        "schedule",
        "day_plan",
        "tasks",
        "habits",
        "focus",
        "alarms",
        "sleep",
        "biometrics",
        "inbox",
        "messages",
        "markets",
        "environment",
        "commute",
        "news",
        "bookmarks"
      ]
    },
    "size": { "enum": ["compact", "standard", "wide", "full"] },
    "context": {
      "enum": ["morning", "workday", "evening", "weekend", "travel", "always"]
    },
    "density": { "enum": ["comfortable", "compact"] },
    "module_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "visible", "position", "size", "contexts", "refresh_interval_seconds", "collapsed"],
      "properties": {
        "module": { "$ref": "#/$defs/module" },
        "visible": { "type": "boolean" },
        "position": { "type": "integer", "minimum": 0, "maximum": 100 },
        "size": { "$ref": "#/$defs/size" },
        "contexts": {
          "type": "array",
          "items": { "$ref": "#/$defs/context" },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 6
        },
        "refresh_interval_seconds": {
          "description": "Minimum seconds between upstream refreshes for this module. Thirty seconds is the floor for any module and no module may poll faster than its provider's rate budget allows.",
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "collapsed": { "type": "boolean" }
      }
    },
    "module_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "is_default",
        "theme",
        "accent",
        "density",
        "briefing_delivery_local",
        "quiet_hours_start_local",
        "quiet_hours_end_local",
        "modules",
        "generation",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "is_default": { "type": "boolean" },
        "theme": { "enum": ["system", "light", "dark", "night_shift"] },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "density": { "$ref": "#/$defs/density" },
        "briefing_delivery_local": {
          "description": "When the composed brief should be ready. Null disables scheduled delivery and leaves the brief on-demand.",
          "anyOf": [
            { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
            { "type": "null" }
          ]
        },
        "quiet_hours_start_local": {
          "anyOf": [
            { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
            { "type": "null" }
          ]
        },
        "quiet_hours_end_local": {
          "anyOf": [
            { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
            { "type": "null" }
          ]
        },
        "modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/module_placement" },
          "minItems": 1,
          "maxItems": 32
        },
        "generation": { "$ref": "common.schema.json#/$defs/generation" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  },
  "$ref": "#/$defs/module_layout"
}
